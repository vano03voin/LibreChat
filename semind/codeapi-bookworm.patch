diff --git a/service/src/semind-policy.test.ts b/service/src/semind-policy.test.ts
new file mode 100644
index 0000000..4916495
--- /dev/null
+++ b/service/src/semind-policy.test.ts
@@ -0,0 +1,32 @@
+import { describe, expect, test } from 'bun:test';
+import { semindPolicy } from './semind-policy';
+import type { Request, Response } from 'express';
+
+function check(method: string, path: string, body = {}) {
+  let allowed = false;
+  let status = 0;
+  let error = '';
+  const res = { status(code: number) { status = code; return this; }, json(value: { error: string }) { error = value.error; } };
+  semindPolicy({ method, path, body } as Request, res as Response, () => { allowed = true; });
+  return { allowed, status, error };
+}
+
+describe('SE-mind Code API admission', () => {
+  test('only stateless Python and file reads/uploads are admitted', () => {
+    process.env.CODEAPI_SEMIND_PROFILE = 'true';
+    expect(check('POST', '/exec', { lang: 'python', code: 'print(1)' }).allowed).toBe(true);
+    expect(check('POST', '/upload').allowed).toBe(true);
+    expect(check('GET', '/download/abc/def').allowed).toBe(true);
+    for (const lang of ['bash', 'javascript', 'sh', '', null]) {
+      expect(check('POST', '/exec', { lang }).status).toBe(403);
+    }
+    for (const body of [{ lang: 'python', tools: [] }, { lang: 'python', runtime_session_hint: 'other' }]) {
+      expect(check('POST', '/exec', body).status).toBe(403);
+    }
+    for (const path of ['/bridge/enroll', '/workspace-tools/execute', '/exec/stream']) {
+      expect(check('POST', path).status).toBe(403);
+    }
+    expect(check('DELETE', '/files/abc/def').status).toBe(403);
+    delete process.env.CODEAPI_SEMIND_PROFILE;
+  });
+});
diff --git a/service/src/semind-policy.ts b/service/src/semind-policy.ts
new file mode 100644
index 0000000..38ecaa7
--- /dev/null
+++ b/service/src/semind-policy.ts
@@ -0,0 +1,19 @@
+import type { RequestHandler } from 'express';
+
+/** Platform policy for the SE-mind stateless Python deployment. */
+export const semindPolicy: RequestHandler = (req, res, next) => {
+  if (process.env.CODEAPI_SEMIND_PROFILE !== 'true') return next();
+  if (req.method === 'POST' && req.path === '/exec') {
+    if (req.body?.lang !== 'python' || req.body?.runtime_session_hint != null ||
+        req.body?.tools != null || req.body?.runtime_session_id != null) {
+      res.status(403).json({ error: 'semind_stateless_python_required' });
+      return;
+    }
+    return next();
+  }
+  if (req.method === 'POST' && ['/upload', '/upload/batch'].includes(req.path)) return next();
+  if (req.method === 'GET' && /^\/(download|files|sessions)\//.test(req.path)) return next();
+  // Programmatic tools, bridge enrollment, workspaces and destructive file deletion
+  // have no public surface in this deployment, even with an otherwise valid JWT.
+  res.status(403).json({ error: 'semind_code_operation_disabled' });
+};
